# never commit any .html file — the site is Next.js (.tsx) only
*.html
# EXCEPTION: Google Search Console verification files (google<token>.html)
# are required by Google and must be committed.
!google*.html

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
