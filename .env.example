# Activate FormSubmit by clicking the confirmation link sent to this inbox.
WAITLIST_TARGET=See@seeai.xyz

# REQUIRED for meaningful production VPN/proxy/Tor detection:
# Set this as a server-side environment variable in Vercel; never use NEXT_PUBLIC_.
# Without the key ProxyCheck limits the free API to 100 IP queries per day.
PROXYCHECK_API_KEY=

# Vercel automatically provides VERCEL=1 and x-vercel-forwarded-for.
# For another trusted platform, set TRUSTED_PROXY_IP_HEADER to the exact,
# authenticated, canonical single-IP header supplied by its trusted ingress.
# Never trust arbitrary x-forwarded-for or x-real-ip headers.
